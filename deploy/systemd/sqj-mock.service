[Unit]
Description=Shangqingju Mock Upstream
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/shangqingju/services/mock-upstream
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4190
Environment=UPSTREAM_MODE=mock
Environment=MOCK_COMPANIES_FILE=fixtures/companies-100.json
Environment=MOCK_COMPANY_MODULES_FILE=fixtures/company-modules-100.json
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.1/bin/node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
