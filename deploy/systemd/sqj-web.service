[Unit]
Description=Shangqingju Web
After=network.target sqj-api.service sqj-mock.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/shangqingju/apps/web
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.1/bin/node .output/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
