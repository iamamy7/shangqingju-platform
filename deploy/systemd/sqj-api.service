[Unit]
Description=Shangqingju Business API
After=network.target sqj-mock.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/shangqingju/services/api
EnvironmentFile=/etc/shangqingju/sqj.env
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.1/bin/node dist/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
