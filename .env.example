NODE_ENV=development
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000
DATABASE_URL=postgresql://sqj:sqj@127.0.0.1:5432/sqj
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-before-deploy
API_KEY_HASH_SALT=replace-before-deploy
UPSTREAM_PROVIDER=mock
UPSTREAM_BASE_URL=http://127.0.0.1:4190
UPSTREAM_API_KEY=mock-client-key
PAYMENT_PROVIDER=mock
INVOICE_PROVIDER=mock

# 热门资讯采集器需返回 JSON 数组或 {"items": [...]}。未配置时，运营后台仅导入本地来源快照联调。
INSIGHTS_COLLECTOR_URL=
INSIGHTS_COLLECTOR_TOKEN=
# 只有同时配置采集器地址并显式开启后，服务才会按时自动采集；所有新稿仍必须人工审核。
INSIGHTS_AUTO_COLLECT=false
INSIGHTS_COLLECT_SCHEDULE=07:30,12:00,17:00
